<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>org.springframework.samples</groupId>
    <artifactId>petclinic</artifactId>
    <version>2.1.0</version>
    <packaging>war</packaging>
    <name>PetClinic</name>

    <properties>
        <!-- ✅ Updated for Java 17 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        
        <!-- Your existing versions -->
        <spring.version>3.2.2.RELEASE</spring.version>
        <hibernate.version>4.1.9.Final</hibernate.version>
        <mysql.version>5.1.25</mysql.version>
        <thymeleaf.version>2.0.18</thymeleaf.version>
        <thymeleaf.extras.springsecurity3.version>2.0.0</thymeleaf.extras.springsecurity3.version>
    </properties>

    <dependencies>
        <!-- keep your existing dependencies unchanged -->
        <!-- (spring, hibernate, mysql, thymeleaf, junit, etc.) -->
    </dependencies>

    <build>
        <defaultGoal>install</defaultGoal>
        <plugins>
            <!-- ✅ Updated Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>

            <!-- your existing plugins (war, surefire, tomcat, sonar, etc.) -->
        </plugins>
    </build>

</project>
